<?xml version="1.0"?>
<launch>
    <arg name="decoder" default="true"/>
    <arg name="dual_fisheye2equirectangular" default="false"/>
    <arg name="dual_fisheye2perspective" default="false"/>
    <arg name="equirectangular2perspective" default="false"/>
    <arg name="imu_filter" default="true"/>
    <arg name="dual_fisheye2equirectangular_config" default="$(find-pkg-share insta360_ros_driver)/config/dual_fisheye2equirectangular.yaml"/>
    <arg name="dual_fisheye2perspective_config" default="$(find-pkg-share insta360_ros_driver)/config/dual_fisheye2perspective.yaml"/>
    <arg name="equirectangular2perspective_config" default="$(find-pkg-share insta360_ros_driver)/config/equirectangular2perspective.yaml"/>
    <arg name="imu_config" default="$(find-pkg-share insta360_ros_driver)/config/imu_filter.yaml"/>
    <!-- Publishes Compressed Images -->
    <node pkg="insta360_ros_driver" exec="insta360_ros_driver" name="insta360_ros_driver" output="log"/>

    <!-- Decodes Compressed Images -->
    <node pkg="insta360_ros_driver" exec="ffmpeg_decoder" name="ffmpeg_decoder" output="log" if="$(var decoder)">
        <param name="compressed_topic" value="/dual_fisheye/image/compressed"/>
        <param name="uncompressed_topic" value="/dual_fisheye/image"/>
        <!-- We can skip decoding every <skip_frame>. So skip_frame = 1 will only publish half the frames, etc. -->
        <param name="skip_frame" value="0"/>
        <!-- If you want to minimize the CPU load the most, you can decode only the i-frames. But the expected FPS is about 1-2 FPS -->
        <param name="i_frame_only" value="false"/> 
    </node>

    <!-- Creates Equirectangular Images -->
    <node if="$(var dual_fisheye2equirectangular)" pkg="insta360_ros_driver" exec="dual_fisheye2equirectangular_cpp" name="dual_fisheye2equirectangular_node" output="screen">
        <param from="$(var dual_fisheye2equirectangular_config)" />
    </node>
    <!-- Creates Perspective Images from dual-fisheye images -->
    <node if="$(var dual_fisheye2perspective)" pkg="insta360_ros_driver" exec="dual_fisheye2perspective_cpp" name="dual_fisheye2perspective_node" output="screen">
        <param from="$(var dual_fisheye2perspective_config)" />
    </node>
    <!-- Creates Perspective Images from equirectangular images -->
    <node if="$(var equirectangular2perspective)" pkg="insta360_ros_driver" exec="equirectangular2perspective_cpp" name="equirectangular2perspective_node" output="screen">
        <param from="$(var equirectangular2perspective_config)" />
    </node>
    <!-- Applies a Madgwick Filter to the 6-DOF IMU to get Orientation -->
    <node if="$(var imu_filter)" pkg="imu_filter_madgwick" exec="imu_filter_madgwick_node" name="imu_filter" output="log">
        <param from="$(var imu_config)"/>
    </node>
</launch>
